# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"

# ─── Email / OTP ─────────────────────────────────────────────────────────────
ENABLE_EMAIL_OTP=true
BYPASS_EMAIL_OTP_ON_ERROR=false

# SMTP credentials (used by @nestjs-modules/mailer)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=your-smtp-password
MAIL_FROM="AgriConnect <no-reply@example.com>"

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
# Obtain these values from the Firebase Console:
#   Project Settings → Service Accounts → Generate new private key
#
# FIREBASE_PROJECT_ID   : e.g. "agriconnect-40a6a"
# FIREBASE_CLIENT_EMAIL : e.g. "firebase-adminsdk-xxxxx@agriconnect-40a6a.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY  : The full PEM private key from the downloaded JSON.
#                         Wrap the value in double-quotes and keep literal \n sequences —
#                         the service will replace them with real newlines at runtime.
#
FIREBASE_PROJECT_ID=agriconnect-40a6a
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@agriconnect-40a6a.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
