## ─── Environment template ─────────────────────────────────────────────────────
## Copy to .env and fill in real values. Never commit files containing secrets.
##
## Railway PostgreSQL — External URL for local dev; Railway injects it automatically in production.
## Find it: Railway dashboard → PostgreSQL service → Connect tab → External URL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.railway.app:PORT/railway"

PORT=3001
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="change_me_to_a_long_random_string"

## Email OTP — cho phép register/login nhanh trong dev mode
## - ENABLE_EMAIL_OTP=false → bỏ qua hoàn toàn OTP (tài khoản tự verified).
##   Đây là mode local hiện tại: KHÔNG có email OTP nào được gửi, BE trả
##   autoVerified=true và client sẽ chuyển thẳng sang đăng nhập.
## - ENABLE_EMAIL_OTP=true + thiếu MAIL_* → BE trả 503 "Hệ thống email chưa cấu hình".
## - ENABLE_EMAIL_OTP=true + SMTP fail runtime → MẶC ĐỊNH trả 503 (không giả vờ
##   thành công, không tự verify → không bypass OTP). Client hiện lỗi rõ ràng.
## - STRICT_OTP=false → ESCAPE HATCH dev/demo: khi SMTP fail thì auto-bypass
##   (đăng ký vẫn thành công, autoVerified=true). CHỈ bật khi cố tình muốn bỏ qua.
ENABLE_EMAIL_OTP=false
# STRICT_OTP=false

## Email (SMTP) — only needed when ENABLE_EMAIL_OTP=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password_16chars
MAIL_FROM='"Agri Connect" <noreply@agriconnect.com>'

## Firebase Admin SDK — generate from Firebase console → Project settings → Service accounts
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

## ─── AI Assistant ───────────────────────────────────────────────────────────
## Gemini API key (active provider) — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
## Groq API key (legacy provider, kept for fallback) — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

## Image moderation (Google Cloud Vision) — chặn NSFW / ảnh không phải nông sản
## TRƯỚC khi gửi vào Gemini. Credentials theo thứ tự ưu tiên:
##   1. GOOGLE_APPLICATION_CREDENTIALS = đường dẫn file service-account JSON
##   2. Tái dùng FIREBASE_* ở trên (cùng GCP project — chỉ cần bật Vision API
##      tại console.cloud.google.com → APIs & Services → Cloud Vision API)
## Không cấu hình gì → moderation tự tắt (fail-open, log warning).
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

## Rate limiting & cost controls
AI_RATE_LIMIT_PER_HOUR=20          # Max requests per user per hour
AI_MAX_TOKENS_PER_REQUEST=500      # Max output tokens per LLM call
AI_DAILY_TOKEN_BUDGET=10000        # Max tokens per user per day (~7-10 conversations)

## ─── MoMo Payment (UAT sandbox) ───────────────────────────────────────────────
MOMO_PARTNER_CODE=MOMOxxxx
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund
## IPN = server→server callback; REDIRECT = trình duyệt buyer quay về sau thanh toán.
MOMO_IPN_URL=https://YOUR_PUBLIC_HOST/payments/momo/ipn
MOMO_REDIRECT_URL=https://YOUR_PUBLIC_HOST/payments/momo/return
## BẮT BUỘC cho redirect sau thanh toán — nếu thiếu, BE fallback http://localhost:3000
## (trình duyệt buyer không tới được → "thanh toán xong nhưng trang trắng").
FRONTEND_URL=https://your-frontend-domain

## ╔══════════════════════════════════════════════════════════════════════════╗
## ║  HYBRID NGROK DEMO MODE  (chạy MoMo webhook ở local, API vẫn trên Railway) ║
## ╠══════════════════════════════════════════════════════════════════════════╣
## ║  To run MoMo webhooks locally while keeping APIs on Railway:               ║
## ║                                                                            ║
## ║  1) Put your ngrok URL in MOMO_IPN_URL and MOMO_REDIRECT_URL on Railway's  ║
## ║     variables panel:                                                       ║
## ║        MOMO_IPN_URL      = https://<your-ngrok>.ngrok-free.app/payments/momo/ipn   ║
## ║        MOMO_REDIRECT_URL = https://<your-ngrok>.ngrok-free.app/payments/momo/return║
## ║                                                                            ║
## ║  2) Run your LOCAL backend with the EXACT SAME DATABASE_URL and            ║
## ║     JWT_SECRET as Railway (so the local server sees the same orders/       ║
## ║     payments and accepts the same tokens). Then `ngrok http 3001` and use  ║
## ║     that ngrok URL above so MoMo's callback hits your local machine.       ║
## ║                                                                            ║
## ║  Note: MOMO_QUERY_ENDPOINT is NOT used by this codebase (no transaction-   ║
## ║  query/reconcile call) — do not bother setting it. Flow relies on IPN +    ║
## ║  redirect only. MOMO_DEV_SIMULATOR=true bypasses real MoMo for offline     ║
## ║  demos (auto-disabled when NODE_ENV=production).                           ║
## ╚══════════════════════════════════════════════════════════════════════════╝
# MOMO_DEV_SIMULATOR=false
